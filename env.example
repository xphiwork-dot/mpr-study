# Variable names only. Copy to .env (gitignored) and fill in, or export them in the shell.
# Needed only for the optional LLM Farm run (setup.sh, retrieval_recall.py and leak_check.py need none).
LLM_FARM_ENDPOINT=
LLM_FARM_KEY=
SMALL_MODEL_NAME=
# Optional: a file that already defines the three variables above (read at run time, never copied).
FARM_ENV_FILE=
# Optional: proxy CA bundle for gdown / model downloads.
REQUESTS_CA_BUNDLE=
